{
  "name": "catexam",
  "productName": "CAT CISSP Exams",
  "version": "0.1.0",
  "description": "CISSP computerized adaptive testing (CAT) exam simulator for Windows and Android",
  "main": "dist/src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "build:mobile": "npm run build && node scripts/build-mobile.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.mobile.json && eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "smoke": "npm run build:mobile && node scripts/smoke.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:android": "npm run build:mobile && cap sync android && cd android && ./gradlew --no-daemon assembleDebug"
  },
  "build": {
    "appId": "com.uxsystems.catexam",
    "productName": "CAT CISSP Exams",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/src/**",
      "questions/*.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
